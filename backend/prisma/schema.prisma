datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  TECHNICIAN
  BRANCH_MANAGER
  FOUNDER_ADMIN
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  googleId        String?   @unique
  phoneNumber     String?   @unique
  email           String?   @unique
  name            String
  role            Role      @default(CUSTOMER)
  avatarUrl       String?
  refreshToken    String?
  password        String?
  technicianId    String?   @unique
  branch          String?
  isOnline        Boolean   @default(false)
  skills          String[]  @default([])
  serviceAreas    String[]  @default([])
  experience      String?
  isActive        Boolean   @default(true)
  isFounder       Boolean   @default(false)
  mustChangePassword Boolean @default(false)
  provider        String?
  isEmailVerified Boolean   @default(false)
  lastLoginAt     DateTime?
  gender          String?
  dateOfBirth     String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  properties    Property[]
  bookings      Booking[]       @relation("CustomerBookings")
  jobs          Booking[]       @relation("TechnicianJobs")
  notifications Notification[]
  auditLogs     AuditLog[]

  // E-Commerce Relations
  savedAddresses CustomerAddress[]
  ecomOrders     EcomOrder[]
  ecomCarts      EcomCart[]
  ecomReturns    EcomReturnRequest[]

  @@index([phoneNumber])
  @@index([email])
}

model Property {
  id                  String    @id @default(uuid()) @db.Uuid
  customerId          String    @db.Uuid
  name                String
  address             String
  installedAppliances String[]  // Array of appliance names
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Relations
  customer      User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  warranties    Warranty[]
  amcContracts  AmcContract[]
  bookings      Booking[]

  @@index([customerId])
}

model ServiceCategory {
  id        String        @id
  nameEn    String
  nameTa    String
  icon      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  // Relations
  items     ServiceItem[]
}

model ServiceItem {
  id              String          @id
  categoryId      String
  nameEn          String
  nameTa          String
  descriptionEn   String
  descriptionTa   String
  basePrice       Float
  durationMinutes Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  // Relations
  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([categoryId])
}

enum BookingStatus {
  PENDING
  WAITING_FOR_TECHNICIAN
  TECHNICIAN_ASSIGNED
  ASSIGNED
  TRAVELLING
  REACHED
  IN_PROGRESS
  PAYMENT_PENDING
  COMPLETED
  CANCELLED
}

model Booking {
  id             String    @id @default(uuid()) @db.Uuid
  localId        String?   @unique
  customerId     String    @db.Uuid
  technicianId   String?   @db.Uuid
  propertyId     String    @db.Uuid
  serviceId      String
  address        String
  scheduledAt    DateTime
  timeSlot       String
  isEmergency    Boolean   @default(false)
  description    String
  imageUrls      String[]  // Array of MinIO uploaded image URLs
  voiceNoteUrl   String?
  voiceTranscript String?
  estimatedPrice Float
  status         BookingStatus @default(PENDING)
  latitude       Float?
  longitude      Float?
  rejectedBy     String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // Relations
  customer      User            @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  technician    User?           @relation("TechnicianJobs", fields: [technicianId], references: [id], onDelete: SetNull)
  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  serviceItem   ServiceItem     @relation(fields: [serviceId], references: [id])
  timeline      BookingTimeline[]
  invoices      Invoice[]

  @@index([customerId])
  @@index([technicianId])
  @@index([propertyId])
  @@index([status])
}

model BookingTimeline {
  id        String    @id @default(uuid()) @db.Uuid
  bookingId String    @db.Uuid
  status    String
  notes     String?
  createdAt DateTime  @default(now())

  // Relations
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  bookingId      String        @db.Uuid
  amount         Float
  taxAmount      Float
  discountAmount Float         @default(0.0)
  totalAmount    Float
  status         InvoiceStatus @default(UNPAID)
  paymentMethod  String?       // UPI, CARD, CAS
  paymentId      String?       // Razorpay payment ID
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Warranty {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @db.Uuid
  itemName    String
  installDate DateTime
  expiryDate  DateTime
  duration    String
  status      String    @default("ACTIVE") // ACTIVE, EXPIRED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model AmcContract {
  id              String    @id @default(uuid()) @db.Uuid
  propertyId      String    @db.Uuid
  applianceName   String
  scheduleType    String    // e.g. "Bi-Annual"
  nextServiceDate DateTime
  checksRemaining Int       @default(2)
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String
  message   String
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @db.Uuid
  action    String
  details   String
  ipAddress String?
  createdAt DateTime  @default(now())

  // Relations
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Product {
  id              String          @id @default(uuid()) @db.Uuid
  category        String
  name            String
  brand           String          @default("Phoenix")
  description     String
  price           Float
  mrp             Float           @default(0.0)
  discountPercent Int             @default(0)
  imageUrl        String
  images          String[]        @default([])
  rating          Float           @default(4.5)
  reviewCount     Int             @default(0)
  stock           Int             @default(50)
  variants        Json?
  specifications  Json?
  warrantyInfo    String?         @default("1 Year Brand Warranty")
  returnPolicy    String?         @default("7 Days Replacement Policy")
  deliveryDays    Int             @default(3)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  orderItems      EcomOrderItem[]
  cartItems       EcomCartItem[]

  @@index([category])
}

enum AddressType {
  HOME
  WORK
  OTHER
}

model CustomerAddress {
  id          String      @id @default(uuid()) @db.Uuid
  customerId  String      @db.Uuid
  fullName    String
  phoneNumber String
  buildingNo  String
  street      String
  area        String
  city        String
  state       String
  pincode     String
  landmark    String?
  addressType AddressType @default(HOME)
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  customer    User        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([pincode])
}

model EcomCart {
  id         String         @id @default(uuid()) @db.Uuid
  customerId String         @unique @db.Uuid
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  customer   User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      EcomCartItem[]
}

model EcomCartItem {
  id              String   @id @default(uuid()) @db.Uuid
  cartId          String   @db.Uuid
  productId       String   @db.Uuid
  quantity        Int      @default(1)
  selectedVariant String?
  savedForLater   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cart            EcomCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, selectedVariant])
  @@index([cartId])
  @@index([productId])
}

enum EcomOrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethodType {
  UPI
  CREDIT_CARD
  DEBIT_CARD
  NET_BANKING
  WALLET
  CASH_ON_DELIVERY
}

enum EcomPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model EcomOrder {
  id                String            @id @default(uuid()) @db.Uuid
  orderNumber       String            @unique
  customerId        String            @db.Uuid
  status            EcomOrderStatus   @default(PLACED)
  deliveryAddress   Json
  deliveryOption    Json
  paymentMethod     PaymentMethodType @default(UPI)
  paymentStatus     EcomPaymentStatus @default(PENDING)
  paymentId         String?
  subtotal          Float
  discountAmount    Float             @default(0.0)
  deliveryFee       Float             @default(0.0)
  couponDiscount    Float             @default(0.0)
  taxAmount         Float             @default(0.0)
  totalAmount       Float
  couponCode        String?
  estimatedDelivery DateTime
  trackingNumber    String?
  timeline          Json              @default("[]")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  customer          User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items             EcomOrderItem[]
  returns           EcomReturnRequest[]

  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
}

model EcomOrderItem {
  id              String    @id @default(uuid()) @db.Uuid
  orderId         String    @db.Uuid
  productId       String    @db.Uuid
  productName     String
  productImage    String
  price           Float
  mrp             Float
  quantity        Int
  selectedVariant String?
  createdAt       DateTime  @default(now())

  order           EcomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Coupon {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  description    String
  discountType   String    // PERCENT, FLAT
  discountValue  Float
  minOrderAmount Float     @default(0.0)
  maxDiscount    Float?
  isActive       Boolean   @default(true)
  expiryDate     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum ReturnType {
  RETURN
  REPLACEMENT
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  PICKED_UP
  COMPLETED
}

model EcomReturnRequest {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @db.Uuid
  customerId String       @db.Uuid
  type       ReturnType   @default(RETURN)
  reason     String
  comments   String?
  status     ReturnStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  order      EcomOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer   User         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([customerId])
}


